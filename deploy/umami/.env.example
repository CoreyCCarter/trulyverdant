# Umami's own secrets. Copy this file to `.env` in this same directory.
#
# BOTH VALUES ARE NEW ONES YOU INVENT. Neither has any connection to the
# blog: not to its database, not to its SECRET_KEY, not to anything in
# /home/verdant/trulyverdant/.env. Do not copy values from there.
#
# Why there is a second Postgres password at all: Umami runs its own
# Postgres, in its own container, on this VPS, holding only analytics.
# Docker creates that database from scratch the first time you start it and
# sets this password on it. Nothing else ever connects to it, and you will
# never type it again -- both services below read it from this one file, so
# they always agree.
#
# Generate each with:  openssl rand -hex 32
#
# Hex, not base64. POSTGRES_PASSWORD is interpolated into a URL
# (postgresql://umami:PASSWORD@db:5432/umami), and base64 contains "/" and
# "+", which break it -- a "/" ends the URL's authority section and Umami
# dies with "TypeError: Invalid URL" before it ever reaches the database.

# Password for Umami's own Postgres container. Invent one.
POSTGRES_PASSWORD=

# Secret Umami uses to sign its own dashboard logins. Invent one.
APP_SECRET=
