# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# REQUIRED. The app refuses to start in production without this.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# REQUIRED for correct canonical URLs, sitemap and RSS. No trailing slash.
SITE_URL=https://trulyverdant.com

# Postgres in production; omit entirely to use a local SQLite file.
DATABASE_URL=postgresql://user:password@host:5432/trulyverdant

# --- Site identity -------------------------------------------------------
SITE_NAME=TrulyVerdant
SITE_TAGLINE=Field notes and growing guides for plant people
SITE_DESCRIPTION=In-depth articles on houseplants, gardening and plant care.
CONTACT_EMAIL=hello@trulyverdant.com
ARTICLES_PER_PAGE=10

# --- Uploads -------------------------------------------------------------
MAX_UPLOAD_MB=10

# --- AdSense -------------------------------------------------------------
# Leave blank until Google approves the site. While blank, no ad code is
# emitted at all and /ads.txt returns 404.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_IN_ARTICLE=
ADSENSE_SLOT_SIDEBAR=

# Served verbatim at /ads.txt. Google will not serve ads without it.
# ADS_TXT=google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0

# Gate ad scripts behind the consent banner. Keep true for EEA/UK traffic.
REQUIRE_COOKIE_CONSENT=true

# Set false on a staging deploy to emit noindex and block crawlers.
SEO_INDEXABLE=true

# --- Serving -------------------------------------------------------------
# Number of trusted reverse proxies in front of the app. 1 when running
# behind nginx; 0 when gunicorn is exposed directly. Trusting more hops than
# exist lets a client spoof its own IP and scheme via forged headers.
PROXY_FIX_HOPS=1

# Gunicorn (see deploy/gunicorn.conf.py). Defaults are usually fine.
# GUNICORN_BIND=unix:/run/trulyverdant/gunicorn.sock
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4
