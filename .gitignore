# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage

# Environments
venv/
.venv/
# Every .env variant, but keep the committed template.
.env
.env.*
!.env.example

# Local database
*.db
dev.db

# Database backups and legacy exports. These contain real user data,
# including password hashes -- never commit them.
backups/
*.dump
*.sql.gz

# One-off maintenance scripts
scripts_drop_legacy.py

# Logs
logs/
*.log*

# Uploaded media - user content, not source
app/static/uploads/*
!app/static/uploads/.gitkeep

.vscode/
.idea/
